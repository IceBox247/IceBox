// IceBox — Prisma schema (PostgreSQL; works locally and on Vercel serverless).
generator client {
  provider = "prisma-client-js"
  // native = local dev; rhel targets = Vercel/AWS Lambda runtimes.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon pooler / pgbouncer) used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection used by `prisma migrate` / `db push`.
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  telegramId    String   @unique
  username      String?
  firstName     String?
  lastName      String?
  photoUrl      String?

  // Economy — stored in whole USDT with 2 decimal precision as Float.
  balance       Float    @default(0) // withdrawable balance (total)
  // Portion of `balance` that came from tasks/referrals/signup/stake rewards —
  // i.e. NOT from real deposits. The tier stakes only accept the deposited
  // portion (balance - earnedBalance); earned ICE USD can only go into the
  // special locked "earned" stake. Always kept <= balance.
  earnedBalance Float    @default(0)
  totalEarned   Float    @default(0) // lifetime earned

  // Daily check-in bonus. `lastCheckIn` is when they last claimed; `checkInStreak`
  // is the consecutive-day count (resets if a UTC day is missed).
  lastCheckIn   DateTime?
  checkInStreak Int      @default(0)

  // Referral graph
  referralCode  String   @unique
  referredById  Int?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]   @relation("Referrals")

  // Connected BSC wallet for holding-based mining levels. The wallet's on-chain
  // ICE USD balance sets the mining level. Only counts once verified (the user
  // signed `walletNonce` to prove control), to stop pasting a whale's address.
  walletAddress   String?
  walletVerifiedAt DateTime?
  walletNonce     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  taskCompletions TaskCompletion[]
  withdrawals     Withdrawal[]
  ledger          LedgerEntry[]
  stakes          Stake[]
  deposits        Deposit[]
  depositAddresses DepositAddress[]
  miner           Miner?

  @@index([referredById])
}

// A user's mining rig ("Glacier"). Users buy `hashrate` with DEPOSITED USD;
// rewards accrue continuously at the configured ICE-per-hash-per-day rate into
// `pending`, and collecting moves `pending` into the earned (ICE) balance.
// `pending` is settled (accrued from `lastAccruedAt`) on every buy/collect so
// the stored value is always current as of `lastAccruedAt`.
model Miner {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  hashrate      Float    @default(0) // total mining power owned (GH/s) — package model
  pending       Float    @default(0) // accrued, uncollected ICE as of lastAccruedAt
  totalMined    Float    @default(0) // lifetime ICE collected
  totalSpent    Float    @default(0) // lifetime USD spent buying hashrate
  // Holding-based level model (MINING_MODEL=levels): the level is derived from the
  // connected wallet's on-chain ICE USD holding, cached here for accrual + ranking.
  level         Int      @default(0)
  peakLevel     Int      @default(0) // highest level ever reached (Level Journey)
  holdingUsd    Float    @default(0) // effective holding value in USD (on-chain + bonus)
  holdingTokens Float    @default(0) // on-chain ICE token amount
  // Goodwill holding credit (USD) — e.g. migrating early users who spent real
  // USD on the old bought-hashrate model into the holding-based level model.
  bonusHoldingUsd Float  @default(0)
  holdingCheckedAt DateTime?
  lastAccruedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// A point in a user's "Level Journey" — recorded when their level changes (and a
// periodic keep-alive), so the Miner Store can chart their progress over time.
model MinerLevelPoint {
  id        Int      @id @default(autoincrement())
  userId    Int
  level     Int
  assetsUsd Float
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Task {
  id          Int      @id @default(autoincrement())
  key         String   @unique // stable identifier e.g. "join_channel"
  title       String
  subtitle    String
  reward      Float
  // action type drives the UI button + verification flow
  actionType  String   // "join" | "visit" | "watch" | "ad"
  actionLabel String   // "Join" | "Visit" | "Watch"
  url         String?  // channel/website/ad url
  // Rewarded-ad network for "ad" tasks: "adsgram" | "monetag". The client shows
  // the ad via the network SDK and only claims once it actually completes.
  provider    String?
  // Telegram chat to verify membership for "join" tasks, e.g. "@iceboxAi".
  // When set, the reward is only credited if the bot confirms the user joined.
  // Requires the bot to be an admin of that channel.
  chatId      String?
  icon        String   // "telegram" | "globe" | "play"
  waitSeconds Int      @default(0) // for "visit" tasks
  maxCount    Int      @default(1) // repeatable tasks (e.g. watch ad 5x)
  // When true, maxCount is a PER-DAY cap that resets each UTC day (ad tasks).
  daily       Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  completions TaskCompletion[]
}

model TaskCompletion {
  id          Int      @id @default(autoincrement())
  userId      Int
  taskId      Int
  count       Int      @default(1)
  rewarded    Float    @default(0)
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
  @@index([userId])
}

model Withdrawal {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float
  address     String
  network     String   @default("BEP20")
  // Which rail pays this out: "ice" = the ICE token on-chain (from earned
  // balance); "usdt" = real USDT via Dextopus (from deposited/staked balance).
  token       String   @default("usdt")
  status      String   @default("pending") // pending | processing | paid | rejected
  createdAt   DateTime @default(now())

  // Payout bookkeeping. `txHash` is the on-chain proof and the idempotency
  // anchor: a row that reaches `processing` is never auto-retried, because a
  // crash between broadcasting and recording could otherwise pay twice.
  txHash      String?
  processedAt DateTime?
  error       String?

  // Dextopus off-ramp. When a withdrawal converts ICE USD -> the user's chosen
  // token, these capture where it goes and the Dextopus request the treasury
  // funds. `dextopusRequestId` is polled to confirm final delivery.
  destChainId            Int?
  destAsset              String?
  dextopusRequestId      String?
  dextopusDepositAddress String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// Maps a user's static Dextopus deposit address back to the user, so an
// incoming deposit webhook (which only carries the address) credits the right
// account. Users can deposit any supported crypto, so there is one stable
// address per (user, origin chain, origin asset) — Dextopus mints it
// deterministically per origin/settlement tuple. Addresses stored lowercased.
model DepositAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  chainId    Int      // origin chain the user sends from
  asset      String   // origin asset symbol/address the user sends
  address    String   @unique
  dextopusId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, chainId, asset])
  @@index([userId])
  @@index([address])
}

// A Dextopus-powered on-ramp deposit. The user is given a per-user static
// deposit address; they send USDT to it and Dextopus settles it (1 USDT = 1 ICE
// USD) to the platform treasury. A completed deposit credits the user's
// withdrawable `balance` exactly once, anchored on `dextopusId` for idempotency
// (the same deposit can arrive via both the webhook and status polling).
model Deposit {
  id             Int      @id @default(autoincrement())
  userId         Int
  // Dextopus deposit/settlement identifiers. `depositAddress` is where the user
  // sends funds; `dextopusId` is Dextopus's own deposit id, unique so a deposit
  // is credited only once no matter how many times we see it.
  depositAddress String
  dextopusId     String?  @unique
  status         String   @default("awaiting") // awaiting | pending | completed | failed | refunded
  credited       Boolean  @default(false)

  // What the user sent, and what settled to the treasury (USD == ICE USD 1:1).
  originAsset       String?
  originChainId     Int?
  originAmount      Float?
  originTxHash      String?
  settlementAmount  Float?
  settlementTxHash  String?
  creditedAmount    Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([depositAddress])
  @@index([status])
}

// Registry of tokens launched through the IceBox creator (any chain).
model CreatedToken {
  id        Int      @id @default(autoincrement())
  chainId   Int
  address   String
  creator   String // lowercased wallet that created it
  name      String
  symbol    String
  decimals  Int      @default(18)
  supply    String   @default("0") // whole tokens, stored as string (can be huge)
  taxed     Boolean  @default(false)
  txHash    String?
  logoUrl   String?
  createdAt DateTime @default(now())

  @@unique([chainId, address])
  @@index([creator])
}

// A stake-to-earn position. The user moves withdrawable `balance` into a
// locked `Stake`; rewards accrue at the tier's daily rate for the lock window
// and can be claimed to `balance` anytime, while the principal stays locked
// until `maturesAt`.
//
// The rate figures and lock length are SNAPSHOT onto the row at stake time, so
// re-tuning the tier specs (in the Vercel env) later never re-prices positions
// that are already open.
model Stake {
  id          Int      @id @default(autoincrement())
  userId      Int
  tier        String   // section key, e.g. "s1" | "s2" | "s3" | "s4" | "earned"
  // "tier"   = normal stake of deposited ICE USD; rewards claimable anytime.
  // "earned" = locked stake of task/referral-earned ICE USD; rewards accrue but
  //            stay locked and release with the principal only at maturity.
  kind        String   @default("tier")
  principal   Float    // amount staked, in whole USD
  apy         Float    // headline APY snapshot, for display (e.g. 15 = 15%)
  dailyRate   Float    // % per day at stake time — this is what actually accrues
  lockDays    Int      // lock/earn window at stake time, in days
  status      String   @default("active") // active | unstaked
  claimed     Float    @default(0) // lifetime rewards already paid out from this stake

  startedAt   DateTime @default(now())
  // Accrual anchor: rewards accrue from here. Reset to `now` on every claim so a
  // claimed reward is never paid twice.
  lastClaimAt DateTime @default(now())
  maturesAt   DateTime // startedAt + lockDays; accrual stops and principal unlocks here
  unstakedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// Immutable audit trail of every balance change.
model LedgerEntry {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float    // positive = credit, negative = debit
  reason      String   // "signup_bonus" | "task" | "referral" | "deposit" | "withdrawal" | "withdrawal_refund" | "stake" | "stake_reward" | "unstake"
  meta        String?  // optional JSON string
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
