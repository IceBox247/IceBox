# ── Telegram ────────────────────────────────────────────────────────────────
# BotFather token for your bot (required for bot + initData validation)
BOT_TOKEN=123456:ABC-your-bot-token-here
# Public bot username WITHOUT the @ (used to build referral links)
BOT_USERNAME=myIceBoxBot
# Public https URL of the Mini App / deployment (Vercel domain in production)
WEBAPP_URL=https://your-app.vercel.app
# Public base URL used to register the Telegram webhook (usually = WEBAPP_URL)
PUBLIC_URL=https://your-app.vercel.app
# Random string shared with Telegram to authenticate webhook calls.
# Generate one: `openssl rand -hex 16`
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
# "webhook" (serverless / Vercel) or "polling" (long-running local server).
# Auto-detected: webhook on Vercel, polling locally. Override if needed.
# BOT_MODE=webhook

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Pooled connection used at runtime (Neon pooler / pgbouncer host).
# On Neon this URL contains "-pooler" and ends with ?sslmode=require
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/icebox?sslmode=require"
# Direct (non-pooled) connection used by `prisma db push` / migrations.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/icebox?sslmode=require"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated allowed CORS origins. Leave empty when web + api share a
# domain (the Vercel deployment). Set for split local dev.
CORS_ORIGIN=http://localhost:5173
# Bypass Telegram initData validation for local browser testing. NEVER in prod.
DEV_ALLOW_UNSIGNED=false

# ── Economy (all amounts in USDT) ───────────────────────────────────────────
REFERRAL_REWARD=2
MIN_WITHDRAWAL=18
SIGNUP_BONUS=0.30

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Base URL of the API. Leave empty to use same-origin "/api" (Vercel default).
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Automated ICE USD payouts (optional; off unless PAYOUT_ENABLED=true)
# ---------------------------------------------------------------------------
# Master switch. Every other value must also be present or payouts stay off.
PAYOUT_ENABLED=false
# ICE USD token contract on BSC.
TOKEN_ADDRESS=
# Hot wallet that signs transfers. Keep only a few days of float here —
# anyone who can read your Vercel env can drain it.
PAYOUT_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Tokens paid per unit of app balance (1 = one token per balance unit).
TOKENS_PER_UNIT=1
# Payouts larger than this are left pending for manual review.
MAX_AUTO_PAYOUT=500
PAYOUT_BATCH_SIZE=5
# Shared secret guarding /api/cron/payouts — openssl rand -hex 16
CRON_SECRET=
