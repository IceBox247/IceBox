# ── Telegram ────────────────────────────────────────────────────────────────
# BotFather token for your bot (required for bot + initData validation)
BOT_TOKEN=123456:ABC-your-bot-token-here
# Public https URL where the web app is hosted (BotFather -> Mini App URL)
WEBAPP_URL=https://your-app.example.com
# Public bot username WITHOUT the @ (used to build referral links)
BOT_USERNAME=myIceBoxBot

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated allowed CORS origins for the web app during local dev
CORS_ORIGIN=http://localhost:5173
# Set to "true" to bypass Telegram initData validation for local browser testing.
# NEVER enable this in production.
DEV_ALLOW_UNSIGNED=false

# ── Economy (all amounts in USDT) ───────────────────────────────────────────
REFERRAL_REWARD=2
MIN_WITHDRAWAL=18
SIGNUP_BONUS=0.30

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Base URL of the API the web app talks to. Leave empty to use same-origin "/api".
VITE_API_BASE=
