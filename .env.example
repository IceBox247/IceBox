# ── Telegram ────────────────────────────────────────────────────────────────
# BotFather token for your bot (required for bot + initData validation)
BOT_TOKEN=123456:ABC-your-bot-token-here
# Public bot username WITHOUT the @ (used to build referral links)
BOT_USERNAME=myIceBoxBot
# Public https URL of the Mini App / deployment (Vercel domain in production)
WEBAPP_URL=https://your-app.vercel.app
# Public base URL used to register the Telegram webhook (usually = WEBAPP_URL)
PUBLIC_URL=https://your-app.vercel.app
# Random string shared with Telegram to authenticate webhook calls.
# Generate one: `openssl rand -hex 16`
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
# "webhook" (serverless / Vercel) or "polling" (long-running local server).
# Auto-detected: webhook on Vercel, polling locally. Override if needed.
# BOT_MODE=webhook

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Pooled connection used at runtime (Neon pooler / pgbouncer host).
# On Neon this URL contains "-pooler" and ends with ?sslmode=require
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/icebox?sslmode=require"
# Direct (non-pooled) connection used by `prisma db push` / migrations.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/icebox?sslmode=require"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated allowed CORS origins. Leave empty when web + api share a
# domain (the Vercel deployment). Set for split local dev.
CORS_ORIGIN=http://localhost:5173
# Bypass Telegram initData validation for local browser testing. NEVER in prod.
DEV_ALLOW_UNSIGNED=false
# Telegram user ids (comma-separated) that can open the in-app Admin dashboard.
# Find your id via @userinfobot. The admin stats are also viewable at
# /api/cron/admin?secret=CRON_SECRET without setting this.
ADMIN_TELEGRAM_IDS=

# ── Economy (all amounts in USDT) ───────────────────────────────────────────
REFERRAL_REWARD=2
MIN_WITHDRAWAL=18            # ICE-token rail minimum
MIN_WITHDRAWAL_USDT=0.5      # USDT rail minimum
SIGNUP_BONUS=0.30
# Two-level deposit referral commission (paid as USDT-withdrawable to referrers).
REF_DEPOSIT_L1_PCT=7
REF_DEPOSIT_L2_PCT=3
# Daily check-in bonus. Per-streak-day reward schedule (comma list); once the
# streak passes the list length it stays at the last value. Credited as earned.
CHECKIN_ENABLED=true
CHECKIN_REWARDS=0.05,0.10,0.15,0.20,0.25,0.30,0.50

# ── Anti-bot / anti-abuse ───────────────────────────────────────────────────
# EMERGENCY kill-switch: set to false to instantly pause ALL withdrawals (e.g.
# during an exploit). Then investigate with /api/cron/investigate (below).
WITHDRAW_ENABLED=true
# Withdrawal rate limit: one FREE withdrawal per rolling window; each extra one
# inside the window costs the fee (kept by the treasury).
WITHDRAW_FREE_WINDOW_HOURS=2
WITHDRAW_EXTRA_FEE=0.5
# One payout address per account (first one used sticks) + not shared across
# accounts. Set to "false" to disable either.
WITHDRAW_LOCK_ADDRESS=true
WITHDRAW_UNIQUE_ADDRESS=true
# Optional extra gates (off by default): min account age before first withdrawal,
# and requiring a signature-verified wallet.
WITHDRAW_MIN_ACCOUNT_AGE_HOURS=0
WITHDRAW_REQUIRE_WALLET=false

# Telegram-channel gates. The bot must be an ADMIN of each channel to verify.
# Mining: members-only channel required to collect mined ICE (blank = no gate).
GATE_MINING_CHANNEL=@iceboxAi
# Withdraw: comma-separated channels required before withdrawing (your 3).
GATE_WITHDRAW_CHANNELS=@iceboxAi,@IceBoxPayout,@IceBoxDeposit
# Master switch (default on) and strict mode (block when the bot can't verify).
GATE_ENABLED=true
GATE_STRICT=false

# ── Rewarded ads (Adsgram + Monetag) ────────────────────────────────────────
# The "Watch an Ad" tasks show a real rewarded ad and only credit ICE once it
# completes. These are FRONTEND (Vite) vars, so they must be present at BUILD
# time on Vercel and are prefixed VITE_. Leave blank and the task shows "Soon".
# Adsgram block id (from https://adsgram.ai dashboard).
VITE_ADSGRAM_BLOCK_ID=
# Monetag zone id (from https://monetag.com dashboard, Telegram Mini App zone).
VITE_MONETAG_ZONE_ID=

# ── Stake to Earn ────────────────────────────────────────────────────────────
# Four amount-range sections. Tune EVERY spec here — the app snapshots these
# values onto each position when it is opened, so changing them later never
# re-prices stakes that are already running.
#
#   *_MIN / *_MAX   inclusive USD range the section accepts
#   *_APY           headline APY shown in the UI (display only)
#   *_DAILY         % reward per day — THIS is what actually accrues
#   *_DURATION      lock length in days (rewards accrue over this window)
#   *_NAME/_BLURB   optional label + one-line pitch
#
# Defaults below match the code defaults; override any subset you like.
# Master switch — set to false to hide staking and refuse new stakes.
STAKING_ENABLED=true

# Section 1 — $1 to $500
STAKE_S1_NAME=Starter
STAKE_S1_MIN=1
STAKE_S1_MAX=500
STAKE_S1_APY=18
STAKE_S1_DAILY=0.05
STAKE_S1_DURATION=30

# Section 2 — $501 to $2,000
STAKE_S2_NAME=Silver
STAKE_S2_MIN=501
STAKE_S2_MAX=2000
STAKE_S2_APY=30
STAKE_S2_DAILY=0.08
STAKE_S2_DURATION=45

# Section 3 — $2,001 to $5,000
STAKE_S3_NAME=Gold
STAKE_S3_MIN=2001
STAKE_S3_MAX=5000
STAKE_S3_APY=45
STAKE_S3_DAILY=0.12
STAKE_S3_DURATION=60

# Section 4 — $5,001 to $10,000
STAKE_S4_NAME=Diamond
STAKE_S4_MIN=5001
STAKE_S4_MAX=10000
STAKE_S4_APY=60
STAKE_S4_DAILY=0.16
STAKE_S4_DURATION=90

# Earned Vault — the ONLY place task/referral-earned ICE USD can be staked.
# Rewards accrue but stay locked; principal + rewards release together at
# maturity and become USDT-withdrawable.
STAKE_EARNED_ENABLED=true
STAKE_EARNED_NAME=Earned Vault
STAKE_EARNED_MIN=1
STAKE_EARNED_APY=40
STAKE_EARNED_DAILY=0.11
STAKE_EARNED_DURATION=100

# ── Dextopus on/off-ramp (USDT ↔ ICE USD) ───────────────────────────────────
# Deposits: users send USDT to a per-user Dextopus address; it settles to the
# treasury and their ICE USD balance is credited 1:1. Withdrawals: ICE USD is
# converted back to USDT and delivered to the user's external wallet.
# Docs: https://dextopus.gitbook.io/dextopus-docs
#
# --- Deposits (on-ramp) ---
# Master switch. Needs DEXTOPUS_API_KEY + TREASURY_ADDRESS to actually run.
DEXTOPUS_ENABLED=false
# Swap-API key from the Dextopus dashboard (sent as the x-api-key header).
DEXTOPUS_API_KEY=
# Base URL of the Dextopus Swap API.
DEXTOPUS_API_BASE=https://swap-api.dextopus.com
# Secret Dextopus signs deposit webhooks with (point the webhook at
# /api/webhooks/dextopus). HMAC-SHA256 over the raw body.
DEXTOPUS_WEBHOOK_SECRET=
# Treasury wallet deposits settle into (the settlement address).
TREASURY_ADDRESS=
# Refund addresses per origin chain family — Dextopus REQUIRES one to mint a
# deposit address (funds return here if a swap fails). EVM defaults to
# TREASURY_ADDRESS; set the others only if you accept deposits on those chains.
REFUND_EVM=
REFUND_SOL=
REFUND_TRON=
REFUND_BTC=
# What the user sends (defaults to USDT on BSC / chain id 56).
DEXTOPUS_ORIGIN_CHAIN_ID=56
DEXTOPUS_ORIGIN_ASSET=USDT
DEXTOPUS_SETTLEMENT_CHAIN_ID=56
DEXTOPUS_SETTLEMENT_ASSET=USDT
# Smallest deposit the UI encourages, in USD.
DEXTOPUS_MIN_DEPOSIT=2
# 1 USDT = this many ICE USD (keep 1 for a 1:1 peg).
DEXTOPUS_RATE=1
#
# --- Withdrawals (off-ramp) ---
# Turn on ICE USD -> USDT withdrawals via Dextopus. The TREASURY signer
# (TREASURY_PRIVATE_KEY below) must hold USDT + gas — it sends USDT to the
# Dextopus quote address, which then delivers to the user. Runs from the
# /api/cron/dextopus-payouts cron. Leave off until the treasury is funded.
DEXTOPUS_WITHDRAW_ENABLED=false
# Private key of the TREASURY wallet that holds your USDT float + gas and signs
# USDT payouts. This is a SEPARATE wallet from PAYOUT_PRIVATE_KEY (the ICE-token
# payout wallet). Set it to the wallet that actually holds USDT — never reuse the
# ICE-token key here, or USDT withdrawals will try to send from a wallet with no
# USDT. Required for USDT withdrawals to go instant.
TREASURY_PRIVATE_KEY=
# RPC the treasury signer broadcasts through (defaults to BSC_RPC_URL).
TREASURY_RPC_URL=https://bsc-dataseed.binance.org
# USDT contract the treasury transfers (default: BSC USDT, 18 decimals).
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
DEXTOPUS_WITHDRAW_ORIGIN_CHAIN_ID=56
DEXTOPUS_WITHDRAW_ORIGIN_ASSET=USDT
# Default destination the user receives on (they choose the wallet address).
DEXTOPUS_WITHDRAW_DEST_CHAIN_ID=56
DEXTOPUS_WITHDRAW_DEST_ASSET=USDT
# Address failed/expired withdrawals refund to (must be one you control;
# defaults to TREASURY_ADDRESS).
DEXTOPUS_REFUND_ADDRESS=
# Optional partner fee taken on every withdrawal (basis points → your wallet).
DEXTOPUS_PARTNER_ADDRESS=
DEXTOPUS_PARTNER_FEE_BPS=0

# ── Two-rail withdrawals & channel alerts ────────────────────────────────────
# ICE TOKEN withdrawals (earned balance → the ICE token, instant on-chain) use
# the direct payout wallet below — set these on for instant ICE payouts:
#   PAYOUT_ENABLED=true, TOKEN_ADDRESS=<ICE token contract>, PAYOUT_PRIVATE_KEY
# USDT withdrawals (deposited/staked balance → USDT) use the Dextopus block above.
#
# Telegram channels the bot posts alerts to. Use the numeric chat id (e.g.
# -1001234567890) or an @channelusername the bot is an ADMIN of. Blank = no alert.
DEPOSIT_CHANNEL=
PAYOUT_CHANNEL=
# Rich alerts: an image on each alert + an "Open IceBox" button below it.
# ALERT_IMAGE_URL must be a PUBLIC image URL Telegram can fetch (host your
# "USD PAID" graphic anywhere, or commit it to web/public and use the domain
# URL). Optional per-type overrides. Leave blank = text alert (button still shown).
ALERT_IMAGE_URL=
ALERT_DEPOSIT_IMAGE_URL=
ALERT_PAYOUT_IMAGE_URL=
# The button. Use a t.me link so it opens the Mini App (NOT the raw domain).
ALERT_BUTTON_TEXT=❄️ Open IceBox
ALERT_BUTTON_URL=https://t.me/myIceBoxBot?startapp
# Block explorer used for tx links in alerts.
EXPLORER_BASE=https://bscscan.com

# ── Glacier mining ───────────────────────────────────────────────────────────
# Users buy hashrate (mining power) with DEPOSITED USD; it mines ICE USD into
# their earned balance continuously. Every rate is tunable here.
MINING_ENABLED=true
MINE_NAME=Glacier
MINE_UNIT=GH/s
# Hashrate gained per $1 spent.
MINE_HASH_PER_USD=1
# Every user mines this many ICE USD/day for FREE, before buying any power.
MINE_BASE_ICE_PER_DAY=1
# Purchase price range (USD) and the daily ICE yield at each end. Price and
# yield each scale geometrically across the tiers: the cheapest ($0.09) adds
# MINE_MIN_DAY ICE/day, the top ($2000) adds MINE_MAX_DAY ICE/day.
MINE_MIN_BUY=0.09
MINE_MAX_BUY=2000
MINE_MIN_DAY=3
MINE_MAX_DAY=10000
# How many tiers to show between the endpoints.
MINE_PACKAGE_COUNT=100
# Each referral who starts mining adds this much hashrate to the referrer.
MINE_REF_BONUS_PER_DAY=0.1
# Daily leaderboard rewards (paid once per UTC day from the cron). Top N miners
# split the USDT pool (withdrawable); top M split the ICE USD pool. By rank.
MINE_REWARDS_ENABLED=true
MINE_DAILY_USDT_POOL=5
MINE_USDT_TOP=10
MINE_DAILY_ICE_POOL=1000
MINE_ICE_TOP=100

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Base URL of the API. Leave empty to use same-origin "/api" (Vercel default).
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Automated ICE USD payouts (optional; off unless PAYOUT_ENABLED=true)
# ---------------------------------------------------------------------------
# Master switch. Every other value must also be present or payouts stay off.
PAYOUT_ENABLED=false
# ICE USD token contract on BSC.
TOKEN_ADDRESS=
# Hot wallet that signs transfers. Keep only a few days of float here —
# anyone who can read your Vercel env can drain it.
PAYOUT_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Tokens paid per unit of app balance (1 = one token per balance unit).
TOKENS_PER_UNIT=1
# Payouts larger than this are left pending for manual review.
MAX_AUTO_PAYOUT=500
PAYOUT_BATCH_SIZE=5
# Shared secret guarding /api/cron/payouts — openssl rand -hex 16
CRON_SECRET=
